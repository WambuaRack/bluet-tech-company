---
import Base from '../layouts/Base.astro';
import { services } from '../lib/data';
import { video } from '../lib/imagekit';
import { site } from '../lib/site';
const hero = video(import.meta.env.PUBLIC_HERO_VIDEO);
const steps = [['Discover', 'We learn your goals, users and limits.'], ['Design', 'Clickable prototypes before any code.'], ['Build', 'Weekly releases you can review.'], ['Launch', 'Staged rollout with live monitoring.'], ['Support', 'A named team that keeps improving it.']];
const stack = ['React', 'Next.js', 'Astro', 'Node.js', 'Python', 'TypeScript', 'PostgreSQL', 'Supabase', 'AWS', 'Azure', 'Docker', 'Kubernetes', 'Terraform', 'Flutter', 'OpenAI'];
---
<Base title="Technology that moves you forward">
  <section id="hero" class="relative flex min-h-[88vh] items-center overflow-hidden">
    {hero && <video class="absolute inset-0 h-full w-full object-cover opacity-30" src={hero} autoplay muted loop playsinline aria-hidden="true"></video>}
    <div class="gridbg absolute inset-0"></div>
    <div class="orb -left-24 top-10 h-96 w-96 bg-bluet"></div><div class="orb -right-20 bottom-0 h-96 w-96 bg-sky" style="animation-delay:-6s"></div>
    <div class="absolute inset-0 hidden md:block" aria-hidden="true">
      <div class="sq h-12 w-12" style="right:24%;top:24%" data-depth="1.2"></div>
      <div class="sq h-9 w-9" style="right:30%;top:34%;animation-delay:-2s" data-depth="0.7"></div>
      <div class="sq h-16 w-16" style="right:16%;top:36%;animation-delay:-4s" data-depth="1.8"></div>
    </div>
    <div class="relative mx-auto w-full max-w-6xl px-5 py-24">
      <h1 class="hero-in max-w-3xl text-5xl font-extrabold leading-[1.02] md:text-7xl">Software that carries your business forward.</h1>
      <p class="hero-in mt-7 max-w-xl text-lg text-mist" style="animation-delay:.15s">Bluet Tech designs, builds and runs custom software, cloud platforms and AI tools for ambitious companies across Africa and beyond.</p>
      <div class="hero-in mt-10 flex flex-wrap gap-3" style="animation-delay:.3s">
        <a href="/contact" class="btn btn-primary">Start a project</a><a href="/services" class="btn btn-ghost">Explore services</a></div>
      <p class="hero-in mt-8 text-sm text-mist" style="animation-delay:.45s">We reply within one working day. Fixed-scope projects. Based in Nairobi, Kenya.</p>
    </div>
  </section>

  <div class="marquee border-y border-line py-5" role="img" aria-label="Technologies we work with"><div class="track" aria-hidden="true">{[...stack, ...stack].map(s => <span>{s}</span>)}</div></div>

  <section class="mx-auto max-w-6xl px-5 py-24">
    <div data-reveal class="flex flex-wrap items-end justify-between gap-4"><div><h2 class="text-3xl font-bold md:text-5xl">What we build</h2><p class="mt-3 max-w-lg text-mist">From first prototype to a platform serving thousands of users.</p></div><a href="/services" class="text-sm text-sky">All services</a></div>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {services.map((s, i) => <a href={`/services/${s.slug}`} class:list={['card group flex flex-col', (i === 0 || i === 5) && 'md:col-span-2']} data-reveal style={`--d:${(i % 3) * 0.08}s`}>
        <span class="glyph transition group-hover:rotate-12"></span><h3 class="mt-5 text-xl font-bold">{s.title}</h3><p class="mt-2 text-sm text-mist">{s.text}</p><span class="mt-5 text-sm text-sky">Learn more</span></a>)}
      <a href="/contact" class="card flex flex-col justify-between bg-gradient-to-br from-bluet/30 to-sky/10" data-reveal><h3 class="text-xl font-bold">Not sure what you need?</h3><span class="mt-6 text-sm text-sky">Talk to an engineer</span></a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-24">
    <h2 data-reveal class="text-3xl font-bold md:text-5xl">How a project runs</h2>
    <ol class="mt-12 grid gap-4 md:grid-cols-5">
      {steps.map(([t, d], i) => <li class="card" data-reveal style={`--d:${i * 0.1}s`}><span class="font-display text-2xl font-bold text-sky">{i + 1}</span><h3 class="mt-3 font-bold">{t}</h3><p class="mt-1 text-sm text-mist">{d}</p></li>)}
    </ol>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-24">
    <div class="flex items-end justify-between"><h2 data-reveal class="text-3xl font-bold md:text-5xl">Latest news</h2><a href="/news" class="text-sm text-sky">All news</a></div>
    <div id="latest" class="mt-10 grid gap-6 md:grid-cols-3"></div>
  </section>

  <section class="mx-auto max-w-6xl px-5">
    <div data-reveal class="relative overflow-hidden rounded-3xl border border-line bg-panel p-10 md:p-16">
      <div class="orb -right-10 -top-10 h-72 w-72 bg-bluet"></div><div class="gridbg absolute inset-0 opacity-60"></div>
      <div class="relative"><h2 class="max-w-xl text-3xl font-bold md:text-5xl">Have something to build? Tell us about it.</h2>
        <div class="mt-8 flex flex-wrap gap-3"><a href="/contact" class="btn btn-primary">Contact Bluet Tech</a><a href="/membership" class="btn btn-ghost">Become a member</a></div>
        <p class="mt-6 text-sm text-mist">Or call <a class="text-sky" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></p></div>
    </div>
  </section>

  <script>
    import { supabase, esc, img, fmt } from '../lib/supabase';
    import { renderList } from '../lib/list';
    renderList(document.getElementById('latest')!, supabase && (() => supabase.from('news').select('slug,title,summary,image,created_at').eq('published', true).order('created_at', { ascending: false }).limit(3)),
      (n) => `<a href="/news/article?slug=${encodeURIComponent(n.slug)}" class="card block">${n.image ? `<img src="${esc(img(n.image))}" alt="${esc(n.title)}" width="800" height="450" loading="lazy" class="mb-4 aspect-video w-full rounded-xl object-cover" />` : ''}<time class="text-sm text-mist">${fmt(n.created_at)}</time><h3 class="mt-1 text-lg font-bold">${esc(n.title)}</h3><p class="mt-2 text-sm text-mist">${esc(n.summary)}</p></a>`, 'News is coming soon.');
  </script>
</Base>
