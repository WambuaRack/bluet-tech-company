---
import '../styles/global.css';
import { site, nav } from '../lib/site';
import Form from '../components/Form.astro';
const { title, description = site.description, image = '/og-image.jpg', noindex = false, bare = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, site.url).href;
const full = title === site.name ? title : `${title} | ${site.name}`;
const ld = { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: site.url, logo: `${site.url}/icon-512.png`, email: site.email, telephone: site.phone };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{full}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <meta name="theme-color" content="#02040b" />
  <meta property="og:type" content="website" /><meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={full} /><meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} /><meta property="og:image" content={new URL(image, site.url).href} />
  <meta property="og:image:alt" content="Bluet Tech logo on a dark background" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={full} /><meta name="twitter:description" content={description} />
  <link rel="icon" href="/favicon.ico" sizes="48x48" /><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=Sora:wght@500;600;700;800&display=swap" rel="stylesheet" />
  <noscript><style>[data-reveal]{opacity:1;transform:none}</style></noscript>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body class="min-h-screen flex flex-col pb-20 md:pb-0" data-ga={site.gaId}>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[60] focus:rounded focus:bg-sky focus:px-3 focus:py-2 focus:text-ink">Skip to content</a>
  <header id="hdr" class="sticky top-0 z-50 border-b backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3">
      <a href="/" aria-label="Bluet Tech home"><img src="/logo-96.webp" width="48" height="48" alt="Bluet Tech logo" class="rounded-lg" /></a>
      {!bare && <nav class="hidden gap-6 lg:flex" aria-label="Main">
        {nav.map(n => <a href={n.href} aria-current={path === n.href ? 'page' : undefined} class:list={['text-sm transition hover:text-sky', path === n.href ? 'text-sky' : 'text-mist']}>{n.label}</a>)}
      </nav>}
      <a href="/contact" class="btn btn-primary hidden text-sm lg:inline-block">Talk to us</a>
      {!bare && <details class="relative lg:hidden"><summary class="cursor-pointer list-none rounded-lg border border-line px-3 py-2 text-sm">Menu</summary>
        <div class="absolute right-0 mt-2 flex w-56 flex-col gap-1 rounded-xl border border-line bg-panel p-3">
          {nav.map(n => <a href={n.href} class="px-2 py-2">{n.label}</a>)}<a href="/contact" class="px-2 py-2">Contact</a><a href="/membership" class="px-2 py-2">Become a member</a></div></details>}
    </div>
  </header>
  <main id="main" class="flex-1"><slot /></main>
  {!bare && <>
  <footer class="mt-24 border-t border-line">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 md:grid-cols-4">
      <div class="md:col-span-2"><img src="/logo-192.webp" width="64" height="64" alt="Bluet Tech logo" loading="lazy" class="rounded-lg" />
        <p class="mt-4 max-w-sm text-sm text-mist">{site.description}</p>
        <div class="mt-5 max-w-sm"><p class="mb-2 text-sm font-bold">Get our news by email</p>
          <Form table="members" submit="Subscribe" type="member"><input type="hidden" name="name" value="Subscriber" /><input type="hidden" name="interest" value="News" />
            <label class="sr-only" for="sub-email">Email address</label><input id="sub-email" type="email" name="email" required autocomplete="email" placeholder="you@example.com" class="field" /></Form></div></div>
      <div><h2 class="mb-3 font-bold">Company</h2><ul class="space-y-2 text-sm text-mist">
        <li><a href="/about">About</a></li><li><a href="/news">News</a></li><li><a href="/careers">Careers</a></li><li><a href="/membership">Become a member</a></li><li><a href="/contact">Contact</a></li></ul></div>
      <div><h2 class="mb-3 font-bold">Visit or call</h2><address class="space-y-1 text-sm not-italic text-mist">
        {site.address.map(l => <div>{l}</div>)}<div class="pt-2"><a href={`mailto:${site.email}`}>{site.email}</a></div><div><a href={`tel:${site.phone.replace(/\s/g,'')}`}>{site.phone}</a></div><div>{site.hours}</div></address></div>
    </div>
    <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 border-t border-line px-5 py-5 text-xs text-mist">
      <span>© {new Date().getFullYear()} {site.name}. All rights reserved.</span><a href="/privacy">Privacy and cookies</a><a href="/terms">Terms and conditions</a></div>
  </footer>
  <div class="fixed inset-x-0 bottom-0 z-40 flex gap-2 border-t border-line bg-ink/95 p-3 md:hidden">
    <a href="/contact" class="btn btn-primary flex-1 text-center text-sm">Get in touch</a><a href="/membership" class="btn btn-ghost flex-1 text-center text-sm">Join</a></div>
  <div id="cookie" hidden role="dialog" aria-label="Cookie consent" class="fixed bottom-20 left-4 right-4 z-50 rounded-2xl border border-line bg-panel p-5 shadow-xl md:bottom-4 md:left-auto md:max-w-sm">
    <p class="text-sm text-mist">We use analytics cookies to understand how the site is used. You can decline. <a href="/privacy" class="text-sky underline">Learn more</a></p>
    <div class="mt-4 flex gap-2"><button data-v="yes" class="btn btn-primary text-sm">Accept</button><button data-v="no" class="btn btn-ghost text-sm">Decline</button></div></div>
  <script is:inline>
  (function(){var k='bluet-consent',b=document.getElementById('cookie'),ga=document.body.dataset.ga,v=null;try{v=localStorage.getItem(k)}catch(e){}
  function load(){if(!ga||window.gtag)return;var s=document.createElement('script');s.async=1;s.src='https://www.googletagmanager.com/gtag/js?id='+ga;document.head.appendChild(s);window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config',ga,{anonymize_ip:true})}
  if(v==='yes')load();else if(!v)b.hidden=false;
  b.querySelectorAll('button').forEach(function(x){x.onclick=function(){try{localStorage.setItem(k,x.dataset.v)}catch(e){}b.hidden=true;if(x.dataset.v==='yes')load()}})})();
  </script></>}
<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.15 });
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
  const hd = document.getElementById('hdr'), tick = () => hd?.classList.toggle('scrolled', scrollY > 8);
  tick(); addEventListener('scroll', tick, { passive: true });
  document.addEventListener('pointermove', (e) => {
    const c = (e.target as HTMLElement).closest?.('.card') as HTMLElement | null;
    if (c) { const r = c.getBoundingClientRect(); c.style.setProperty('--mx', e.clientX - r.left + 'px'); c.style.setProperty('--my', e.clientY - r.top + 'px'); }
    const h = document.getElementById('hero');
    if (h && !reduce) { const x = e.clientX / innerWidth - 0.5, y = e.clientY / innerHeight - 0.5;
      h.querySelectorAll<HTMLElement>('[data-depth]').forEach((el) => { const d = Number(el.dataset.depth); el.style.translate = `${x * d * 40}px ${y * d * 40}px`; }); }
  });
</script>
</body></html>
