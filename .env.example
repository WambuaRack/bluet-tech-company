# ===== COPY THIS FILE TO ".env" FOR LOCAL USE, AND ADD THE SAME NAMES IN VERCEL =====
# Variable names must stay exactly as written. Replace only the values on the right.

# REPLACE: Supabase > Project Settings > API > "Project URL"  (starts with https://, no trailing slash)
PUBLIC_SUPABASE_URL=https://REPLACE-WITH-YOUR-PROJECT-ID.supabase.co

# REPLACE: Supabase > Project Settings > API > "anon public" key (starts with eyJ). Never use service_role.
PUBLIC_SUPABASE_ANON_KEY=REPLACE-WITH-YOUR-ANON-PUBLIC-KEY

# REPLACE: your live website address (use your Vercel address until you add a domain)
PUBLIC_SITE_URL=https://REPLACE-WITH-YOUR-DOMAIN

# OPTIONAL: Google Analytics measurement ID (looks like G-XXXXXXXXXX). Leave empty to disable analytics.
PUBLIC_GA_ID=

# OPTIONAL: only if you use ImageKit for images
PUBLIC_IMAGEKIT_ENDPOINT=
PUBLIC_HERO_VIDEO=
